{
  "name": "TalentVerse React and FastAPI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "frontend/package.json"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "python -m pip install --user -r requirements.txt && npm --prefix frontend ci",
  "postAttachCommand": {
    "backend": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload",
    "frontend": "npm --prefix frontend run dev -- --host 0.0.0.0"
  },
  "portsAttributes": {
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "TalentVerse",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    5173
  ]
}